# =====================================================================
# KEYSTONE — Environment Variables Template
#
# Copy this file:   cp .env.example .env
# Then fill in real values in .env
# NEVER commit .env to version control (it is already in .gitignore)
# =====================================================================

# ─── PostgreSQL (used by both the postgres and backend services) ──────
POSTGRES_DB=keystone
POSTGRES_USER=keystone_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── Spring Boot datasource ──────────────────────────────────────────
# When running with docker-compose the host MUST be "postgres" (the service name).
# When running locally (mvnw spring-boot:run) change to "localhost".
DB_URL=jdbc:postgresql://postgres:5432/keystone
DB_USERNAME=keystone_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate a strong secret (minimum 256 bits / 32 bytes):
#   PowerShell:  [Convert]::ToBase64String((1..64 | ForEach-Object { [byte](Get-Random -Max 256) }))
#   Unix/Mac:    openssl rand -base64 64
JWT_SECRET=CHANGE_ME_base64_encoded_secret_at_least_44_characters
JWT_EXPIRATION=86400000

# ─── Optional overrides ──────────────────────────────────────────────
# SERVER_PORT=8080
