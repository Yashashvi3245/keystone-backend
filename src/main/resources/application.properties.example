# =============================================
# KEYSTONE — Example configuration
# Copy to application.properties and fill in values.
# NEVER commit real secrets to version control.
# =============================================

spring.application.name=keystone-backend

# -----------------------------------------------
# DATABASE — replace with your PostgreSQL details
# -----------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/keystone
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# -----------------------------------------------
# JPA — Flyway owns the schema, not Hibernate
# -----------------------------------------------
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

# -----------------------------------------------
# FLYWAY
# -----------------------------------------------
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# -----------------------------------------------
# JWT — generate a strong random Base64 secret
# e.g.: openssl rand -base64 64
# -----------------------------------------------
jwt.secret=REPLACE_WITH_STRONG_BASE64_SECRET_AT_LEAST_256_BITS
jwt.expiration=86400000

# -----------------------------------------------
# SERVER
# -----------------------------------------------
server.port=8080

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
logging.level.org.springframework.security=WARN
logging.level.com.keystone=INFO

# -----------------------------------------------
# SWAGGER
# -----------------------------------------------
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
